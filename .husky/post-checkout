#!/usr/bin/env sh
. "$(dirname "$0")/husky-use-node.sh"

BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)
PREVIOUS_BRANCH=$(git rev-parse --symbolic-full-name --abbrev-ref=loose @{-1} 2>/dev/null || true)

if [ -z "$PREVIOUS_BRANCH" ]; then
  PREVIOUS_BRANCH="main"
  echo "Unable to determine the previous branch. Falling back to '$PREVIOUS_BRANCH'."
fi

set +e
OUTPUT=$(node .husky/check-branch.mjs 2>&1)
VALID=$?
set -e

if [ "$VALID" -ne 0 ]; then
  echo "$OUTPUT"
  echo "Invalid branch name: '$BRANCH_NAME'. Switching back to '$PREVIOUS_BRANCH'."
  echo "The invalid branch was kept so local commits are not discarded."
  echo "Rename it before continuing:"
  echo "  git branch -m '$BRANCH_NAME' <type>/<issue>-<kebab-title>"

  if git checkout "$PREVIOUS_BRANCH"; then
    echo "Switched back to '$PREVIOUS_BRANCH'."
  else
    echo "Failed to switch back. Handle manually."
    exit 1
  fi

  exit 1
fi

echo "Branch name validation passed for: '$BRANCH_NAME'."
