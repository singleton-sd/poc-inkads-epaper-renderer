{
  "name": "@singleton-sd/inkads-epaper-renderer",
  "version": "0.3.0",
  "private": true,
  "description": "Shared TypeScript e-paper image renderer for InkAds",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.22.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singleton-sd/poc-inkads-epaper-renderer.git"
  },
  "bugs": {
    "url": "https://github.com/singleton-sd/poc-inkads-epaper-renderer/issues"
  },
  "homepage": "https://github.com/singleton-sd/poc-inkads-epaper-renderer#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm build && node --test \"dist/**/*.spec.js\"",
    "release": "release-it -VV --dry-run --ci",
    "release:ci": "release-it --ci",
    "worktree:add": "bash ./scripts/add-worktree.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "@release-it/conventional-changelog": "^10.0.6",
    "@types/node": "^22.17.2",
    "@types/pngjs": "^6.0.5",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "release-it": "^19.2.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  }
}
